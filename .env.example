# PostgreSQL shared by the application and Superset metadata
POSTGRES_USER=ai_bi_user
POSTGRES_PASSWORD=replace_with_a_unique_url_safe_password
APP_DB_NAME=ai_bi
SUPERSET_DB_NAME=superset

# FastAPI
APP_NAME=AI BI Assistant API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ai_bi_user:replace_with_a_unique_url_safe_password@postgres:5432/ai_bi
FRONTEND_URL=http://localhost:43117
SUPERSET_URL=http://superset:8088

# Next.js (browser-facing URL)
NEXT_PUBLIC_API_URL=http://localhost:48123
NEXT_PUBLIC_SUPERSET_URL=http://localhost:58088

# Apache Superset administrator and signing key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace_with_a_unique_admin_password
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_characters

# Read-only Superset connection to the analytics database (ai_bi)
SUPERSET_ANALYTICS_DB_USER=superset_reader
SUPERSET_ANALYTICS_DB_PASSWORD=replace_with_a_unique_url_safe_password

# Redis (internal Docker network address)
REDIS_URL=redis://redis:6379/0
